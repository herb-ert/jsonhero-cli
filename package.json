{
  "name": "jsonhero-cli",
  "version": "0.0.2",
  "description": "jsonhero-cli is a powerful and developer-friendly command-line tool for exploring, transforming, and inspecting JSON files. Whether you're dealing with massive API responses, debugging nested configurations, or working with structured logs, jsonhero-cli helps you navigate and manipulate JSON like a hero — right from your terminal.",
  "main": "src/bin.ts",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herb-ert/jsonhero-cli.git"
  },
  "author": "herb-ert",
  "license": "MIT",
  "bin": {
    "jsonhero": "./dist/bin.js"
  },
  "keywords": [
    "json",
    "cli",
    "json-cli",
    "json viewer",
    "json explorer",
    "json pretty print",
    "json minify",
    "json diff",
    "json tools",
    "terminal json viewer",
    "tui",
    "typescript",
    "developer tools",
    "data transformation",
    "schema generator",
    "jsonpath",
    "json to csv",
    "json to yaml"
  ],
  "bugs": {
    "url": "https://github.com/herb-ert/jsonhero-cli/issues"
  },
  "homepage": "https://github.com/herb-ert/jsonhero-cli#readme",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "commander": "^14.0.0"
  }
}
